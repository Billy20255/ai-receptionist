# --- Twilio (telephony layer) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # the number Twilio provisioned, e.g. +19545551234

# --- Anthropic (conversation + qualifying logic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Property lookup (county GIS open-data portal) ---
# Broward: https://gis.broward.org/ArcGIS/rest/services  (confirm exact parcel FeatureServer layer URL before go-live)
# Miami-Dade / Palm Beach: same ArcGIS REST pattern, different base URL — swap here per client's service area
COUNTY_PARCEL_FEATURE_SERVICE_URL=https://gis.broward.org/arcgis/rest/services/OpenData/Parcels/MapServer/0
GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder

# --- Calendar (booking) ---
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json

# --- Dispatch notification (where the qualified lead alert goes) ---
DISPATCH_CHANNEL=sms            # sms | slack | email
DISPATCH_SMS_TO=                # e.g. +19545559999 — sales rep's cell
SLACK_WEBHOOK_URL=
DISPATCH_EMAIL_TO=

# --- App ---
APP_BASE_URL=https://your-deployed-domain.com   # must be public HTTPS for Twilio webhooks
QUALIFY_SCORE_THRESHOLD=75
